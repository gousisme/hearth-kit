{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hearth data contract",
  "type": "object",
  "required": [
    "games"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mark": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "user": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "initials": {
              "type": "string"
            },
            "avatarUrl": {
              "type": "string"
            }
          }
        }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "view"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "view": {
            "enum": [
              "home",
              "browse",
              "external"
            ]
          },
          "filter": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "sort": {
                "enum": [
                  "new",
                  "title"
                ]
              },
              "saved": {
                "type": "boolean"
              }
            }
          },
          "href": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "hero": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gameId"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string"
          }
        }
      }
    },
    "featured": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "gameId"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "kicker": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "image": {
            "enum": [
              "hero",
              "poster"
            ]
          },
          "size": {
            "enum": [
              "wide",
              "narrow"
            ]
          }
        }
      }
    },
    "shelves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "gameIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "style": {
            "enum": [
              "poster",
              "ranked"
            ]
          },
          "gameIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filter": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "sort": {
                "enum": [
                  "new",
                  "title"
                ]
              },
              "saved": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Stable id"
          },
          "title": {
            "type": "string"
          },
          "steamAppId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "art": {
            "type": "object",
            "properties": {
              "poster": {
                "type": "string",
                "format": "uri"
              },
              "hero": {
                "type": "string",
                "format": "uri"
              },
              "logo": {
                "type": "string",
                "format": "uri"
              },
              "header": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "tagline": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "developer": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "releaseYear": {
            "type": [
              "integer",
              "null"
            ]
          },
          "size": {
            "type": "string"
          },
          "rating": {
            "type": "string"
          },
          "requirements": {
            "type": "object",
            "properties": {
              "minimum": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "recommended": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "similarIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "downloadUrl": {
            "type": "string",
            "pattern": "^https?://"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https?://"
          },
          "hue": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          }
        },
        "additionalProperties": true
      }
    }
  }
}