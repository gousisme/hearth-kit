{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hearth data contract",
  "type": "object",
  "required": [
    "games"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "site": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mark": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "user": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "initials": {
              "type": "string"
            },
            "avatarUrl": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "href": {
              "type": "string"
            }
          }
        }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "view"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "view": {
            "enum": [
              "home",
              "browse",
              "external"
            ]
          },
          "filter": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "sort": {
                "enum": [
                  "updated",
                  "release",
                  "new",
                  "title"
                ]
              },
              "saved": {
                "type": "boolean"
              }
            }
          },
          "href": {
            "type": "string"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "hero": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gameId"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string"
          }
        }
      }
    },
    "featured": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "gameId"
        ],
        "properties": {
          "gameId": {
            "type": "string"
          },
          "kicker": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "image": {
            "enum": [
              "hero",
              "poster"
            ]
          },
          "size": {
            "enum": [
              "wide",
              "narrow"
            ]
          }
        }
      }
    },
    "shelves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "gameIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "style": {
            "enum": [
              "poster",
              "ranked"
            ]
          },
          "gameIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filter": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              },
              "query": {
                "type": "string"
              },
              "sort": {
                "enum": [
                  "updated",
                  "release",
                  "new",
                  "title"
                ]
              },
              "saved": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Stable id"
          },
          "title": {
            "type": "string"
          },
          "steamAppId": {
            "type": [
              "integer",
              "null"
            ]
          },
          "art": {
            "type": "object",
            "properties": {
              "poster": {
                "type": "string",
                "format": "uri"
              },
              "hero": {
                "type": "string",
                "format": "uri"
              },
              "logo": {
                "type": "string",
                "format": "uri"
              },
              "header": {
                "type": "string",
                "format": "uri"
              },
              "fallback": {
                "type": "string"
              }
            }
          },
          "tagline": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "developer": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "releaseYear": {
            "type": [
              "integer",
              "null"
            ]
          },
          "size": {
            "type": "string"
          },
          "rating": {
            "type": "string"
          },
          "requirements": {
            "type": "object",
            "properties": {
              "minimum": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "recommended": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "similarIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "downloadUrl": {
            "type": "string",
            "pattern": "^https?://"
          },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https?://"
          },
          "ranks": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "description": "Positions in lists the site orders: feed, 'cat:<id>', upd. Lower = earlier."
          },
          "addedAt": {
            "type": "number",
            "minimum": 0,
            "description": "ms since epoch; site publish date"
          },
          "updatedAt": {
            "type": "number",
            "minimum": 0,
            "description": "ms; last site update (0 = never)"
          },
          "releasedAt": {
            "type": "number",
            "minimum": 0,
            "description": "ms; the game's own release date"
          },
          "steamUrl": {
            "type": "string",
            "format": "uri"
          },
          "media": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "image",
                    "video",
                    "embed"
                  ]
                },
                "thumb": {
                  "type": "string",
                  "format": "uri"
                },
                "src": {
                  "type": "string",
                  "format": "uri"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "src": {
                        "type": "string",
                        "format": "uri"
                      },
                      "type": {
                        "type": "string"
                      }
                    }
                  }
                },
                "stream": {
                  "type": "string",
                  "format": "uri",
                  "description": "DASH .mpd; needs dash.js on the page"
                },
                "page": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "downloads": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "href"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "href": {
                  "type": "string",
                  "format": "uri"
                },
                "kind": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                }
              }
            }
          },
          "password": {
            "type": "string"
          },
          "guide": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "update": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "closed": {
                "type": "boolean"
              }
            }
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  }
}
